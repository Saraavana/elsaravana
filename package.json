{
  "name": "elsaravana",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio and blog powered by Astro",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "content:import": "node scripts/import-recovered-blog.mjs",
    "format": "prettier --write \"**/*.{astro,ts,js,json,md,yml,yaml}\"",
    "start": "astro dev",
    "backend:dev": "npm --prefix ./elsaravana-api-main run develop",
    "backend:start": "npm --prefix ./elsaravana-api-main run start"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.3.0"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.2"
  }
}
